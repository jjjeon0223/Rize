{
  "appId": "com.jjjeon0223.habittracker",
  "appName": "Habit Tracker",
  "webDir": "build",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "always",
    "scrollEnabled": false,
    "allowsLinkPreview": false
  },
  "plugins": {
    "Keyboard": {
      "resize": "native",
      "style": "dark",
      "resizeOnFullScreen": true
    }
  }
}
